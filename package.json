{
  "name": "ti4-ttpg-ts",
  "version": "1.1.2",
  "description": "Twilight Imperium 4 for Tabletop Playground",
  "main": "dist/index.js",
  "license": "Unlicense",
  "private": false,
  "scripts": {
    "setup": "ttpg-scripts setup",
    "dev": "ttpg-scripts dev",
    "clean": "ttpg-scripts clean && rm -rf dist",
    "reset": "ttpg-scripts reset",
    "build": "ttpg-scripts build",
    "purge": "ttpg-scripts purge",
    "libpack": "ttpg-scripts libpack",
    "watch": "ttpg-scripts watch",
    "index": "yarn cti ./src -e _how-to -e _test -e ref-obj -i '*.test.ts' -i '*.testp.ts' -i 'jest-setup.ts' && find . -name 'index.ts.bak' -exec rm {} \\;",
    "prepublishOnly": "yarn index && tsc -p tsconfig.json && yarn tsdown",
    "check:prettier": "prettier --check src",
    "test": "jest",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts --debug src",
    "circular": "npx madge --circular --extensions ts ./src"
  },
  "devDependencies": {
    "@tabletop-playground/api": "0.41.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.11",
    "@types/klaw-sync": "^6.0.5",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "create-ts-index": "^1.14.0",
    "eslint": "^9.7.0",
    "fs-extra": "^11.2.0",
    "jest": "^29.7.0",
    "klaw-sync": "^6.0.0",
    "monotone-chain-convex-hull": "^1.1.0",
    "prettier": "^3.3.3",
    "sharp": "^0.34.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsdown": "^0.23.0",
    "ttpg-mock": "^1.0.60",
    "ttpg-scripts": "^1.5.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@types/lodash": "^4.17.21",
    "lodash": "^4.17.21",
    "ttpg-darrell": "^1.2.7",
    "zod": "3.22.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "require": "./dist/mock/index.js",
      "default": "./dist/mock/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
